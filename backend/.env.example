# ==============================================================================
# Environment Variables Example - BKPAD Inventaris Backend
# Salin file ini menjadi ".env" lalu sesuaikan dengan konfigurasi Anda.
# ==============================================================================

# Port server backend (Gunakan 4001 untuk local dev agar sesuai dengan vite proxy target)
PORT=4001

# Format koneksi PostgreSQL: postgresql://<user>:<password>@<host>:<port>/<database>
# Jika menggunakan PostgreSQL dari Docker container (host port 5433):
DATABASE_URL=postgresql://bkpad_user:bkpad_pass@localhost:5433/bkpad_inventaris

# Jika menggunakan PostgreSQL lokal standalone (port default 5432):
# DATABASE_URL=postgresql://postgres:password@localhost:5432/bkpad_inventaris

# Set "true" jika koneksi PostgreSQL memerlukan SSL (misal: di cloud provider)
DATABASE_SSL=false
